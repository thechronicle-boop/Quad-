{
  // Cloudflare settings: Quad is a ready-made website, so this just serves the files.
  "name": "quad",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,      // gives the site a public quad.<your-name>.workers.dev address
  "preview_urls": false,
  "assets": {
    "directory": "./",
    "not_found_handling": "single-page-application"
  }
}
